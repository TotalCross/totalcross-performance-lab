-        record.fields[34] = warmNowNs() - start;
+        record.fields[34] = warmSummaryOnlyForTest ? 0 : warmNowNs() - start;
@@ -1183 +1212 @@ int skia_image_backing_draw_to_surface(int32 targetSurface, int64_t sourceHandle
-            warmWritePixelsRecords.push_back(record);
+            if (!warmSummaryOnlyForTest) warmWritePixelsRecords.push_back(record);
@@ -1188 +1217 @@ int skia_image_backing_draw_to_surface(int32 targetSurface, int64_t sourceHandle
-        const uint64_t fallbackStart = warmNowNs();
