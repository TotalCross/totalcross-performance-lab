+static bool testAdmissionMemoryAccounting() {
+    skia_image_backing_reset_accounting_for_test();
+    skia_image_backing_test_metric(200,1);
+    const int64_t decoded=skia_image_backing_create_empty(4,4);
+    const int64_t first=skia_image_backing_create_empty(8,8);
+    const int64_t second=skia_image_backing_create_empty(2,2);
+    if (!decoded || !first || !second) return false;
+    skia_image_backing_test_metric(201,static_cast<int>(decoded));
+    skia_image_backing_test_metric(202,static_cast<int>(first));
+    skia_image_backing_test_metric(202,static_cast<int>(first));
+    skia_image_backing_test_metric(202,static_cast<int>(second));
+    bool valid=skia_image_backing_test_metric(203,8)==2
+        && skia_image_backing_test_metric(203,10)==272
+        && skia_image_backing_test_metric(203,18)==64;
+    skia_image_backing_release(first);
+    valid=valid && skia_image_backing_test_metric(203,8)==1
+        && skia_image_backing_test_metric(203,10)==16
+        && skia_image_backing_test_metric(203,11)==272
+        && skia_image_backing_test_metric(203,12)==1;
+    skia_image_backing_release(second);skia_image_backing_release(decoded);
+    valid=valid && skia_image_backing_test_metric(203,8)==0
+        && skia_image_backing_test_metric(203,10)==0
+        && skia_image_backing_test_metric(203,16)==0;
+    // Both native speculative kinds still require second observation, under accounting.
+    const uint32_t key[]={42,17};
+    for(int kind=1;kind<=2;++kind) {
+        int64_t source=skia_image_backing_create_empty(4,4);
+        valid=valid && skia_image_backing_variant_observe_for_test(source,kind,key,2)==0
+            && skia_image_backing_variant_observe_for_test(source,kind,key,2)==1
+            && skia_image_backing_variant_observe_for_test(source,kind,key,2)==2;
+        skia_image_backing_release(source);
+    }
+    skia_image_backing_test_metric(200,0);
+    if (!valid) std::fputs("admission memory category accounting failed\n",stderr);
+    else std::puts("admission memory category accounting assertions passed");
+    return valid;
+}
+
@@ -565,0 +604 @@ int main(int argc, char** argv) {
