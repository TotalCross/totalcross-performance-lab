+package totalcross.ui.image;
+
+/** Isolated diagnostics. Primitive ledgers never retain Images, pipelines or backings. */
+final class AdmissionMemoryForTest {
+  static boolean enabled;
+  static boolean diagnostics;
+  static long liveCount, peakCount, liveBytes, peakBytes, installs, detaches, replacements, invalidations;
+  static long pendingDiscarded, materializations, materializationNs, allocatedBytes;
+  static long[] paints, mats, admissions, hits;
+  static int[] widths, heights, formats;
+  static long[] bytes;
+  static int[] keyIndices;
+  static long[] keyScales, keyGenerations;
+  static int keyCount;
+  static boolean[] keyAdmitted;
+
+  static void start(int count) {
+    enabled=true; diagnostics=true;
+    liveCount=peakCount=liveBytes=peakBytes=installs=detaches=replacements=invalidations=0;
+    pendingDiscarded=materializations=materializationNs=allocatedBytes=0;
+    paints=new long[count];mats=new long[count];admissions=new long[count];hits=new long[count];
+    widths=new int[count];heights=new int[count];formats=new int[count];bytes=new long[count];
+    keyIndices=new int[count*4+16];keyAdmitted=new boolean[keyIndices.length];keyScales=new long[keyIndices.length];keyGenerations=new long[keyIndices.length];keyCount=0;
+    NativeImageBacking.metricForTest(200,1);
+  }
+  static boolean tracked(ImagePipeline p) {return enabled && p!=null && p.admissionProbeIndexForTest>=0 && p.admissionProbeIndexForTest<paints.length;}
+  static long size(Image image) {
+    if(image.backing==null)return 0;
+    if(image.backing instanceof NativeImageBacking)return ((NativeImageBacking)image.backing).backingBytesForTest();
+    RasterImageBacking b=(RasterImageBacking)image.backing;
+    return 4L*(b.pixelsOfAllFrames()!=null?b.pixelsOfAllFrames().length:b.pixels()!=null?b.pixels().length:0);
+  }
+  static void tag(ImageBacking backing, int metric) {
+    if(backing instanceof NativeImageBacking){
+      long h=((NativeImageBacking)backing).nativeHandleForBridge();
+      if(h<=0||h>Integer.MAX_VALUE)throw new IllegalStateException("probe handle out of private metric range");
+      NativeImageBacking.metricForTest(metric,(int)h);
+    }
+  }
+  static void source(ImagePipeline p) {
+    if(p.root() instanceof EncodedImageSource)tag(((EncodedImageSource)p.root()).decodedBackingForPreparationCleanup(),201);
+  }
+  static void resolved(ImagePipeline p, Image image, long scale, long generation, long elapsed) {
+    if(!tracked(p))return;int i=p.admissionProbeIndexForTest;
+    source(p);tag(image.backing,202);materializations++;mats[i]++;
+    long size=size(image);allocatedBytes+=size;materializationNs+=elapsed;
+    bytes[i]=size;widths[i]=image.getPixelWidth();heights[i]=image.getPixelHeight();
+    formats[i]=image.backing instanceof NativeImageBacking?((NativeImageBacking)image.backing).formatForTest():0;
+    for(int k=0;k<keyCount;k++)if(keyIndices[k]==i&&keyScales[k]==scale&&keyGenerations[k]==generation)return;
+    if(keyCount==keyIndices.length)throw new IllegalStateException("probe key ledger exhausted");
+    keyIndices[keyCount]=i;keyScales[keyCount]=scale;keyGenerations[keyCount++]=generation;
+  }
+  static void admittedKey(ImagePipeline p,long scale,long generation) {
+    for(int k=0;k<keyCount;k++)if(keyIndices[k]==p.admissionProbeIndexForTest&&keyScales[k]==scale&&keyGenerations[k]==generation)keyAdmitted[k]=true;
+  }
+  static void installed(ImagePipeline p, Image image) {
+    long n=size(image);p.cachedProbeBytesForTest=n;p.cachedProbeTrackedForTest=true;
+    liveCount++;liveBytes+=n;installs++;admissions[p.admissionProbeIndexForTest]++;
+    peakCount=Math.max(peakCount,liveCount);peakBytes=Math.max(peakBytes,liveBytes);
+  }
+  static void detached(ImagePipeline p, boolean replacement) {
+    if(!p.cachedProbeTrackedForTest)return;
+    liveCount--;liveBytes-=p.cachedProbeBytesForTest;detaches++;if(replacement)replacements++;
+    p.cachedProbeTrackedForTest=false;p.cachedProbeBytesForTest=0;
+  }
+}
