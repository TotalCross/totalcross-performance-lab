@@ -1191 +1220 @@ int skia_image_backing_draw_to_surface(int32 targetSurface, int64_t sourceHandle
-        record.fields[36] = warmNowNs() - fallbackStart;
+        record.fields[36] = warmSummaryOnlyForTest ? 0 : warmNowNs() - fallbackStart;
@@ -1194 +1223 @@ int skia_image_backing_draw_to_surface(int32 targetSurface, int64_t sourceHandle
-        warmWritePixelsRecords.push_back(record);
+        if (!warmSummaryOnlyForTest) warmWritePixelsRecords.push_back(record);
@@ -1319,0 +1349,16 @@ uint64_t skia_image_backing_test_metric(int32 metric, int32 format) {
+    if (metric == 108) { warmSummaryOnlyForTest = format == 1; return warmSummaryOnlyForTest; }
+    if (metric == 205) return admissionMemoryEnabledForTest && admissionMaterializationForTest;
+    if (metric == 204) {admissionMaterializationForTest = format == 1; return admissionMaterializationForTest;}
+    if (metric == 200) {
+        admissionMemoryTags.clear();
+        for (auto& category : admissionMemoryMetrics) std::fill_n(category,7,uint64_t(0));
+        admissionMemoryEnabledForTest = format == 1; return admissionMemoryEnabledForTest;
+    }
+    if (metric == 201 || metric == 202) {
+        admissionMemoryTagBacking(findBacking(format),metric == 201 ? 2 : 1); return 0;
+    }
+    if (metric == 203) {
+        const int category = format / 8, field = format % 8;
+        return category >= 1 && category <= 2 && field >= 0 && field < 7
+            ? admissionMemoryMetrics[category][field] : 0;
+    }
