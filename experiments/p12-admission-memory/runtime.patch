+
+// Reserved existing NativeImageBacking test metric IDs; off in normal startup.
+enum { WP_SWITCH=100, WP_ENABLED=101, WP_METRICS=102, WP_RECORD_COUNT=103,
+       WP_REASONS=104, WP_RECORD_FIELD=105, WP_FAIL_NEXT=106 };
+// Metrics: attempts,hits,fallbacks,bytes,clippedHits,opacityScans,scanPixels,
+// attemptNs,writeNs,fallbackNs,fallbackDraws.
+// Reasons: 0 none,1 invalid,2 alpha,3 source,4 matrix,5 fractional device,
+// 6 extent mismatch,7 bounds,8 opacity,9 unsupported format,10 pixels,11 write.
+// Record fields: handle,format,width,height,opacityBefore/After,hit,reason,
+// bytes,clipped; float32-bit input source[4],logicalDest[4],mappedDevice[4];
+// clipped source[4],clipped device[4]; float32-bit matrix scale/translation[4];
+// attemptNs,writeNs,fallbackNs. All 37 fields retained for offline analysis.
