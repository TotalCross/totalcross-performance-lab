diff --git a/TotalCrossVM/src/nm/ui/skia/skia_image_backing.cpp b/TotalCrossVM/src/nm/ui/skia/skia_image_backing.cpp
index 074285cfb..a7fbe9a08 100644
--- a/TotalCrossVM/src/nm/ui/skia/skia_image_backing.cpp
+++ b/TotalCrossVM/src/nm/ui/skia/skia_image_backing.cpp
@@ -8,0 +9,5 @@
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include "skia_writepixels_probe.h"
+
@@ -55,0 +61,52 @@ uint64_t promotionBytesForTest;
+// Experiment-only historical bit-2 equivalent; zero in every normal startup.
+static bool warmWritePixelsEnabledForTest;
+static bool failWarmWritePixelsForTest;
+static bool warmSummaryOnlyForTest;
+// Diagnostic tags hold addresses only, never ownership. Categories: derived=1, decoded=2.
+static bool admissionMemoryEnabledForTest;
+static bool admissionMaterializationForTest;
+struct AdmissionMemoryTag { int category; uint64_t bytes; };
+static std::map<const NativeImageBackingRecord*, AdmissionMemoryTag> admissionMemoryTags;
+// live count, peak count, live bytes, peak bytes, releases, tags, allocated bytes.
+static uint64_t admissionMemoryMetrics[3][7];
+
+static void admissionMemoryRemove(const NativeImageBackingRecord& backing) {
+    auto found = admissionMemoryTags.find(&backing);
+    if (found == admissionMemoryTags.end()) return;
+    auto& m = admissionMemoryMetrics[found->second.category];
+    --m[0]; m[2] -= found->second.bytes; ++m[4];
+    admissionMemoryTags.erase(found);
+}
+static void admissionMemoryTagBacking(const NativeImageBackingRecord* backing, int category) {
+    if (!admissionMemoryEnabledForTest || !backing) return;
+    auto found = admissionMemoryTags.find(backing);
+    if (found != admissionMemoryTags.end()) {
+        if (found->second.category == category && found->second.bytes == backing->backingBytes) return;
+        admissionMemoryRemove(*backing);
+    }
+    admissionMemoryTags[backing] = {category, backing->backingBytes};
