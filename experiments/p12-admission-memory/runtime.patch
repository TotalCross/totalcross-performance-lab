+// Copyright (C) 2026 Amalgam Solucoes em TI Ltda
+//
+// SPDX-License-Identifier: LGPL-2.1-only
+package totalcross.ui.image;
+import static org.junit.jupiter.api.Assertions.*;
+import org.junit.jupiter.api.*;
+class ImageAdmissionMemoryExperimentTest {
+  private ImagePipeline p;
+  @BeforeEach void start() throws Exception {
+    AdmissionMemoryForTest.start(1);
+    p=new Image(4,4).getSmoothScaledInstance(2,2).pipelineForSmoke();
+    p.admissionProbeIndexForTest=0;
+  }
+  @AfterEach void stop() {AdmissionMemoryForTest.enabled=false;}
+  @Test void installationReplacementReleaseCountActualStorage() throws Exception {
+    p.cacheMaterializedVariant(1,new Image(4,4),1);
+    assertEquals(64,AdmissionMemoryForTest.liveBytes);
+    p.cacheMaterializedVariant(2,new Image(8,8),1);
+    assertEquals(256,AdmissionMemoryForTest.liveBytes);
+    assertEquals(256,AdmissionMemoryForTest.peakBytes);
+    assertEquals(1,AdmissionMemoryForTest.peakCount);
+    assertEquals(1,AdmissionMemoryForTest.replacements);
+    assertEquals(1,p.cachedVariantCountForSmoke());
+    p.releaseCachedVariantTextures();
+    assertEquals(256,AdmissionMemoryForTest.liveBytes);
+    p.clearCachedVariants();
+    assertEquals(0,AdmissionMemoryForTest.liveBytes);
+    assertEquals(0,AdmissionMemoryForTest.liveCount);
+    assertEquals(2,AdmissionMemoryForTest.detaches);
+  }
+  @Test void pendingOwnsNoRasterAndChangedKeyDiscardsPending() {
+    assertFalse(p.observeMaterializedVariant(1,1));
+    assertEquals(0,AdmissionMemoryForTest.liveBytes);
+    assertFalse(p.observeMaterializedVariant(2,1));
+    assertEquals(1,AdmissionMemoryForTest.pendingDiscarded);
+    assertTrue(p.observeMaterializedVariant(2,1));
+    assertFalse(p.pendingForAdmissionProbe());
+  }
+  @Test void generationMismatchCountsOnceWithoutChangingOwnership() throws Exception {
+    p.cacheMaterializedVariant(1,new Image(4,4),1);
+    assertNull(p.cachedMaterializedVariant(1,2));
+    assertNull(p.cachedMaterializedVariant(1,2));
+    assertEquals(1,AdmissionMemoryForTest.invalidations);
+    assertEquals(64,AdmissionMemoryForTest.liveBytes);
+    assertNotNull(p.cachedMaterializedVariant(1,1));
+  }
+  @Test void exactKeyLedgerIncludesUnadmittedAllocatedWork() throws Exception {
+    Image raster=new Image(4,4);
+    AdmissionMemoryForTest.resolved(p,raster,1,1,7);
+    AdmissionMemoryForTest.resolved(p,raster,1,1,9);
+    AdmissionMemoryForTest.resolved(p,raster,2,1,11);
+    assertEquals(2,AdmissionMemoryForTest.keyCount);
+    assertEquals(3,AdmissionMemoryForTest.materializations);
+    assertEquals(192,AdmissionMemoryForTest.allocatedBytes);
+    assertEquals(27,AdmissionMemoryForTest.materializationNs);
+    assertEquals(0,AdmissionMemoryForTest.liveBytes);
+  }
+  @Test void disabledAccountingDoesNotTrackInstallation() throws Exception {
+    AdmissionMemoryForTest.enabled=false;
+    p.cacheMaterializedVariant(1,new Image(4,4),1);
+    p.cacheMaterializedVariant(2,new Image(8,8),1);
+    assertEquals(0,AdmissionMemoryForTest.liveBytes);
+    assertEquals(0,AdmissionMemoryForTest.installs);
+    assertEquals(1,p.cachedVariantCountForSmoke());
+  }
+}
diff --git a/TotalCrossSDK/src/test/java/totalcross/ui/image/ImageImmediateAdmissionExperimentTest.java b/TotalCrossSDK/src/test/java/totalcross/ui/image/ImageImmediateAdmissionExperimentTest.java
