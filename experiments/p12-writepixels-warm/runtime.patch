+// Experiment-only historical bit-2 equivalent; zero in every normal startup.
+static bool warmWritePixelsEnabledForTest;
+static bool failWarmWritePixelsForTest;
+static uint64_t warmWritePixelsMetrics[11];
+static uint64_t warmWritePixelsReasons[12];
+struct WarmWritePixelsRecord { uint64_t fields[37] = {}; };
+static std::vector<WarmWritePixelsRecord> warmWritePixelsRecords;
+// Historical backing has opacity state; current backing does not. Keep proof
+// metadata entirely outside backing representation and key it by handle/generation.
+static std::map<std::pair<int64_t, uint64_t>, int> warmOpacityProofs;
+
+static uint64_t warmNowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+static uint64_t warmFloatBits(float value) {
+    uint32_t bits; std::memcpy(&bits, &value, sizeof(bits)); return bits;
+}
+static void warmReset() {
+    std::fill_n(warmWritePixelsMetrics, 11, uint64_t(0));
+    std::fill_n(warmWritePixelsReasons, 12, uint64_t(0));
+    warmWritePixelsRecords.clear();
+}
