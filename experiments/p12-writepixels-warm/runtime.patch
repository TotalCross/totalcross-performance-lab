@@ -340,0 +370,204 @@ void recordSurfaceMutation(int32 surfaceId) {
+bool integralWritePixelsCoordinate(float value) {
+    return std::isfinite(value) && std::floor(value) == value;
+}
+
+struct WritePixelsDeviceCopyPlan {
+    SkIRect sourcePixels;
+    SkIRect destinationPixels;
+    bool clipped;
+};
+
+enum class WritePixelsRejectReason {
+    InvalidTargetOrSource,
+    AlphaMask,
+    Matrix,
+    SourceRect,
+    SizeMismatch,
+    FractionalDestination,
+    DestinationBounds,
+};
+
+static int warmPlanRejection;
+bool rejectWritePixelsPlan(WritePixelsRejectReason reason) {
+    switch (reason) {
+    case WritePixelsRejectReason::InvalidTargetOrSource: warmPlanRejection = 1; break;
+    case WritePixelsRejectReason::AlphaMask: warmPlanRejection = 2; break;
+    case WritePixelsRejectReason::SourceRect: warmPlanRejection = 3; break;
+    case WritePixelsRejectReason::Matrix: warmPlanRejection = 4; break;
+    case WritePixelsRejectReason::FractionalDestination: warmPlanRejection = 5; break;
+    case WritePixelsRejectReason::SizeMismatch: warmPlanRejection = 6; break;
+    case WritePixelsRejectReason::DestinationBounds: warmPlanRejection = 7; break;
+    }
+    return false;
+}
+
+bool buildWritePixelsDeviceCopyPlan(
+    SkCanvas* targetCanvas, bool validSource, int32 sourceWidth, int32 sourceHeight,
+    float srcLeft, float srcTop, float srcRight, float srcBottom,
+    float dstLeft, float dstTop, float dstRight, float dstBottom,
+    int32 alphaMask, bool knownOpaque, WritePixelsDeviceCopyPlan* plan) {
+    if (!targetCanvas || !validSource || sourceWidth <= 0 || sourceHeight <= 0 || !plan) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::InvalidTargetOrSource);
+    }
+    if (alphaMask != 255) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::AlphaMask);
+    }
+    if (!integralWritePixelsCoordinate(srcLeft) || !integralWritePixelsCoordinate(srcTop)
+        || !integralWritePixelsCoordinate(srcRight) || !integralWritePixelsCoordinate(srcBottom)
+        || srcRight <= srcLeft || srcBottom <= srcTop
+        || srcLeft < 0 || srcTop < 0 || srcRight > sourceWidth || srcBottom > sourceHeight) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::SourceRect);
+    }
+
+    const SkMatrix matrix = targetCanvas->getTotalMatrix();
+    if (matrix.hasPerspective() || matrix.getSkewX() != 0 || matrix.getSkewY() != 0
+        || !std::isfinite(matrix.getScaleX()) || !std::isfinite(matrix.getScaleY())
+        || !std::isfinite(matrix.getTranslateX()) || !std::isfinite(matrix.getTranslateY())
+        || matrix.getScaleX() <= 0 || matrix.getScaleY() <= 0) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::Matrix);
+    }
+
+    const float deviceLeft = matrix.getScaleX() * dstLeft + matrix.getTranslateX();
+    const float deviceTop = matrix.getScaleY() * dstTop + matrix.getTranslateY();
+    const float deviceRight = matrix.getScaleX() * dstRight + matrix.getTranslateX();
+    const float deviceBottom = matrix.getScaleY() * dstBottom + matrix.getTranslateY();
+    if (!integralWritePixelsCoordinate(deviceLeft) || !integralWritePixelsCoordinate(deviceTop)
+        || !integralWritePixelsCoordinate(deviceRight)
+        || !integralWritePixelsCoordinate(deviceBottom)) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::FractionalDestination);
+    }
+
+    const SkIRect sourceRect = SkIRect::MakeLTRB(
+        static_cast<int32>(srcLeft), static_cast<int32>(srcTop),
+        static_cast<int32>(srcRight), static_cast<int32>(srcBottom));
+    const SkIRect mappedDestination = SkIRect::MakeLTRB(
+        static_cast<int32>(deviceLeft), static_cast<int32>(deviceTop),
+        static_cast<int32>(deviceRight), static_cast<int32>(deviceBottom));
+    if (mappedDestination.width() != sourceRect.width()
+        || mappedDestination.height() != sourceRect.height()) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::SizeMismatch);
+    }
+
+    SkIRect deviceClip;
+    SkPixmap targetPixels;
+    if (!targetCanvas->getDeviceClipBounds(&deviceClip) || !targetCanvas->peekPixels(&targetPixels)) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::DestinationBounds);
+    }
+    SkIRect visibleDestination = mappedDestination;
+    if (!visibleDestination.intersect(deviceClip)
+        || !visibleDestination.intersect(SkIRect::MakeWH(targetPixels.width(), targetPixels.height()))) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::DestinationBounds);
+    }
+
+    const int32 sourceOffsetX = visibleDestination.left() - mappedDestination.left();
+    const int32 sourceOffsetY = visibleDestination.top() - mappedDestination.top();
+    const SkIRect visibleSource = SkIRect::MakeLTRB(
+        sourceRect.left() + sourceOffsetX, sourceRect.top() + sourceOffsetY,
+        sourceRect.left() + sourceOffsetX + visibleDestination.width(),
+        sourceRect.top() + sourceOffsetY + visibleDestination.height());
+    if (!sourceRect.contains(visibleSource)
+        || visibleSource.width() != visibleDestination.width()
+        || visibleSource.height() != visibleDestination.height()) {
+        return rejectWritePixelsPlan(WritePixelsRejectReason::SourceRect);
+    }
+
+    plan->sourcePixels = visibleSource;
+    plan->destinationPixels = visibleDestination;
+    plan->clipped = visibleDestination.left() != mappedDestination.left()
+        || visibleDestination.top() != mappedDestination.top()
+        || visibleDestination.right() != mappedDestination.right()
+        || visibleDestination.bottom() != mappedDestination.bottom();
+    return true;
+}
+
+// Restored from f5dad132 proveOpaqueForWritePixels RGBA alpha scan.
+static bool warmProveOpaque(int64_t handle, NativeImageBackingRecord* source) {
+    auto key = std::make_pair(handle, source->generation);
+    auto known = warmOpacityProofs.find(key);
+    if (known != warmOpacityProofs.end()) return known->second == 1;
+    sk_sp<SkImage> image = source->snapshot();
+    SkPixmap pixmap;
+    if (!image || !image->peekPixels(&pixmap)) return false;
+    bool opaque = true;
+    for (int32 y = 0; y < source->height && opaque; ++y) {
+        const uint8_t* row = static_cast<const uint8_t*>(pixmap.addr(0, y));
+        if (!row) return false;
+        for (int32 x = 0; x < source->width; ++x) {
+            if (row[static_cast<size_t>(x) * 4 + 3] != 0xff) { opaque = false; break; }
+        }
+    }
+    warmOpacityProofs[key] = opaque ? 1 : 2;
+    ++warmWritePixelsMetrics[5];
+    warmWritePixelsMetrics[6] += static_cast<uint64_t>(source->width) * source->height;
+    return opaque;
+}
+
+static bool warmTryWritePixels(SkCanvas* canvas, int64_t handle,
+    NativeImageBackingRecord* source, float sl, float st, float sr, float sb,
+    float dl, float dt, float dr, float db, int32 alpha, WarmWritePixelsRecord* record) {
+    const auto key = std::make_pair(handle, source ? source->generation : uint64_t(0));
+    record->fields[0] = handle;
+    record->fields[1] = source ? static_cast<int>(source->format) : 255;
+    record->fields[2] = source ? source->width : 0;
+    record->fields[3] = source ? source->height : 0;
+    auto known = warmOpacityProofs.find(key);
+    record->fields[4] = known == warmOpacityProofs.end() ? 0 : known->second;
+    record->fields[5] = record->fields[4];
+    const float inputs[] = {sl, st, sr, sb, dl, dt, dr, db};
+    for (int i = 0; i < 8; ++i) record->fields[10 + i] = warmFloatBits(inputs[i]);
+    if (canvas) {
+        const SkMatrix matrix = canvas->getTotalMatrix();
+        const float device[] = {matrix.getScaleX()*dl+matrix.getTranslateX(),
+            matrix.getScaleY()*dt+matrix.getTranslateY(),
+            matrix.getScaleX()*dr+matrix.getTranslateX(),
+            matrix.getScaleY()*db+matrix.getTranslateY(),
+            matrix.getScaleX(), matrix.getScaleY(), matrix.getTranslateX(), matrix.getTranslateY()};
+        for (int i = 0; i < 4; ++i) {
+            record->fields[18+i] = warmFloatBits(device[i]);
+            record->fields[30+i] = warmFloatBits(device[4+i]);
+        }
+    }
+    auto reject = [&](int reason) {
+        record->fields[7] = reason; ++warmWritePixelsReasons[reason];
+        ++warmWritePixelsMetrics[2]; return false;
+    };
+    WritePixelsDeviceCopyPlan plan;
+    warmPlanRejection = 0;
+    if (!buildWritePixelsDeviceCopyPlan(canvas, source != nullptr,
+            source ? source->width : 0, source ? source->height : 0,
+            sl, st, sr, sb, dl, dt, dr, db, alpha,
+            record->fields[4] == 1, &plan)) return reject(warmPlanRejection);
+    const int coords[] = {plan.sourcePixels.left(), plan.sourcePixels.top(),
+        plan.sourcePixels.right(), plan.sourcePixels.bottom(),
+        plan.destinationPixels.left(), plan.destinationPixels.top(),
+        plan.destinationPixels.right(), plan.destinationPixels.bottom()};
+    for (int i=0; i<8; ++i) record->fields[22+i] = static_cast<uint64_t>(coords[i]);
+    record->fields[9] = plan.clipped;
+    // This default-only experiment restores the historical RGBA branch. No
+    // compact conversion or representation change is introduced to force hits.
+    if (source->format != BackingFormat::RGBA8888) return reject(9);
+    bool opaque = warmProveOpaque(handle, source);
+    known = warmOpacityProofs.find(key);
+    record->fields[5] = known == warmOpacityProofs.end() ? 0 : known->second;
+    if (!opaque) return reject(8);
+    sk_sp<SkImage> image = source->snapshot();
+    SkPixmap pixmap, subset;
+    if (!image || !image->peekPixels(&pixmap)
+        || !pixmap.extractSubset(&subset, plan.sourcePixels)) return reject(10);
+    const uint64_t writeStart = warmNowNs();
+    bool written;
+    if (failWarmWritePixelsForTest) { failWarmWritePixelsForTest = false; written = false; }
+    else written = canvas->writePixels(subset.info(), subset.addr(), subset.rowBytes(),
+        plan.destinationPixels.left(), plan.destinationPixels.top());
+    record->fields[35] = warmNowNs() - writeStart;
+    warmWritePixelsMetrics[8] += record->fields[35];
+    if (!written) return reject(11);
+    record->fields[6] = 1;
+    record->fields[8] = static_cast<uint64_t>(plan.sourcePixels.width())
+        * static_cast<uint64_t>(plan.sourcePixels.height()) * 4;
+    ++warmWritePixelsMetrics[1];
+    warmWritePixelsMetrics[3] += record->fields[8];
+    warmWritePixelsMetrics[4] += plan.clipped ? 1 : 0;
+    return true;
+}
+
