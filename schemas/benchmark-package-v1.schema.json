{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TotalCross image-rendering Windows package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "platform",
    "generatedAt",
    "totalcrossSourceCommit",
    "runtimeArtifactSourceCommit",
    "benchmarkSourceCommit",
    "benchmarkWorkingTreeDirty",
    "dataset",
    "buildConfiguration",
    "profileInventory",
    "profiles",
    "runtimeBinaries"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageType": { "enum": ["image-rendering-windows", "image-rendering-macos"] },
    "platform": { "enum": ["windows", "macos"] },
    "generatedAt": { "type": "string", "minLength": 20 },
    "totalcrossSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runtimeArtifactSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "benchmarkSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "benchmarkWorkingTreeDirty": { "type": "boolean" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runtimeProvenance": { "$ref": "official-runtime-provenance-v1.schema.json" },
    "buildConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jdk", "sdkHome", "nativeRuntimeDirectory", "deployTarget"],
      "properties": {
        "jdk": { "type": "string", "minLength": 1 },
        "sdkHome": { "type": "string", "minLength": 1 },
        "nativeRuntimeDirectory": { "type": "string", "minLength": 1 },
        "deployTarget": { "enum": ["win32", "macos"] },
        "architecture": { "type": "string", "minLength": 1 },
        "runtimeArtifactMode": { "enum": ["local-release-build", "github-actions-package"] },
        "sdkBuildCommand": { "type": "array", "items": { "type": "string" } },
        "javaCompileRelease": { "const": 8 }
      }
    },
    "profileInventory": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": [
        "default", "target-color", "physical-variant", "raster-variants", "compact",
        "scroll-reuse", "prepared-legacy", "prepared-semaphore", "combined-standard", "combined-compact"
      ] }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/profile" }
    },
    "runtimeBinaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/fileHash" }
    }
  },
  "definitions": {
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryClass", "executable", "workingDirectory", "runtimeFiles"],
      "properties": {
        "entryClass": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "runtimeFiles": {
          "type": "array",
          "items": { "$ref": "#/definitions/fileHash" }
        }
      }
    }
  }
}
