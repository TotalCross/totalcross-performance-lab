{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TotalCross/totalcross-performance-lab/schemas/benchmark-summary-v1.schema.json",
  "title": "TotalCross benchmark summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "family", "workload", "profile", "dataset", "runtimeSourceCommit", "benchmarkSourceCommit", "rounds", "failures", "statistics", "environment"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "summary" },
    "family": { "enum": ["decode", "scroll", "preparation", "pacing"] },
    "workload": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "dataset": { "type": ["object", "null"] },
    "runtimeSourceCommit": { "type": "string", "minLength": 7 },
    "benchmarkSourceCommit": { "type": ["string", "null"] },
    "rounds": { "type": "array", "minItems": 1, "items": { "$ref": "benchmark-run-v1.schema.json" } },
    "failures": { "type": "integer", "minimum": 0 },
    "statistics": { "type": "object" },
    "environment": { "$ref": "environment-v1.schema.json" }
  }
}
