{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TotalCross/totalcross-performance-lab/schemas/environment-v1.schema.json",
  "title": "TotalCross benchmark environment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostOs", "hostArchitecture", "javaVersion", "totalcrossBuild", "hostName"],
  "properties": {
    "hostOs": { "type": "string", "minLength": 1 },
    "hostArchitecture": { "type": "string", "minLength": 1 },
    "javaVersion": { "type": "string", "minLength": 1 },
    "totalcrossBuild": { "type": "string", "minLength": 1 },
    "hostName": { "type": "string", "minLength": 1 },
    "sessionType": { "type": ["string", "null"] },
    "displayRefreshHz": { "type": ["number", "null"], "exclusiveMinimum": 0 }
  }
}
