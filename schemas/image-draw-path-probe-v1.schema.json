{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-draw-path-probe-v1.schema.json",
  "$comment": "Copyright (C) 2026 Amalgam Solucoes em TI Ltda; SPDX-License-Identifier: LGPL-2.1-only",
  "title": "One stabilized whole-tree draw-path sample and eighteen individual ImageControls",
  "type": "object",
  "required": [
    "scrollDriver",
    "imageControls",
    "rows",
    "columns",
    "tileWidth",
    "scrollPosition",
    "stabilizationRepaints",
    "aggregateSamples",
    "perControlSamples",
    "prepareRequests",
    "preparation",
    "sameImageInstances",
    "sameControlInstances",
    "sameRowInstances",
    "physicalCopyAccounting",
    "lastStatusScope",
    "aggregate",
    "perControl",
    "unexpectedDisabledPathActivity",
    "individualTimingNs"
  ],
  "properties": {
    "scrollDriver": {
      "const": "draw-path-probe"
    },
    "imageControls": {
      "const": 663
    },
    "rows": {
      "const": 221
    },
    "columns": {
      "const": 3
    },
    "tileWidth": {
      "const": 179
    },
    "scrollPosition": {
      "const": 0
    },
    "stabilizationRepaints": {
      "const": 1
    },
    "aggregateSamples": {
      "const": 1
    },
    "perControlSamples": {
      "const": 18
    },
    "prepareRequests": {
      "const": 0
    },
    "preparation": {
      "const": false
    },
    "sameImageInstances": {
      "const": true
    },
    "sameControlInstances": {
      "const": true
    },
    "sameRowInstances": {
      "const": true
    },
    "physicalCopyAccounting": {
      "const": "hit-only; attempt/fallback counters unavailable"
    },
    "lastStatusScope": {
      "const": "last copyRect plan attempt in each accounting sample"
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "perControl": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "unexpectedDisabledPathActivity": {
      "type": "boolean"
    },
    "individualTimingNs": {
      "type": "object",
      "required": [
        "min",
        "median",
        "max",
        "sum"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "sum": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "counters": {
      "type": "object",
      "required": [
        "copyRectPlanAttempts",
        "copyRectPlanHandled",
        "copyRectPlanFallbacks",
        "copyRectPlanLastStatus",
        "cachedFinalRasterProbes",
        "cachedFinalRasterHits",
        "cachedFinalRasterMisses",
        "identityAttempts",
        "identityHits",
        "identityFallbacks",
        "physicalCopyHits",
        "genericGeometryDraws",
        "smoothResampleDraws",
        "directDrawPlanExecutions",
        "targetColorHits",
        "targetColorMaterializations",
        "targetColorFallbacks",
        "physicalVariantHits",
        "physicalVariantMaterializations",
        "physicalVariantFallbacks"
      ],
      "additionalProperties": false,
      "properties": {
        "copyRectPlanAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "copyRectPlanHandled": {
          "type": "integer",
          "minimum": 0
        },
        "copyRectPlanFallbacks": {
          "type": "integer",
          "minimum": 0
        },
        "copyRectPlanLastStatus": {
          "type": "integer",
          "minimum": 0
        },
        "cachedFinalRasterProbes": {
          "type": "integer",
          "minimum": 0
        },
        "cachedFinalRasterHits": {
          "type": "integer",
          "minimum": 0
        },
        "cachedFinalRasterMisses": {
          "type": "integer",
          "minimum": 0
        },
        "identityAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "identityHits": {
          "type": "integer",
          "minimum": 0
        },
        "identityFallbacks": {
          "type": "integer",
          "minimum": 0
        },
        "physicalCopyHits": {
          "type": "integer",
          "minimum": 0
        },
        "genericGeometryDraws": {
          "type": "integer",
          "minimum": 0
        },
        "smoothResampleDraws": {
          "type": "integer",
          "minimum": 0
        },
        "directDrawPlanExecutions": {
          "type": "integer",
          "minimum": 0
        },
        "targetColorHits": {
          "type": "integer",
          "minimum": 0
        },
        "targetColorMaterializations": {
          "type": "integer",
          "minimum": 0
        },
        "targetColorFallbacks": {
          "type": "integer",
          "minimum": 0
        },
        "physicalVariantHits": {
          "type": "integer",
          "minimum": 0
        },
        "physicalVariantMaterializations": {
          "type": "integer",
          "minimum": 0
        },
        "physicalVariantFallbacks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "aggregate": {
      "type": "object",
      "required": [
        "rawStatus",
        "rowPaintCount",
        "rowPaintNs",
        "imagePaintCount",
        "imagePaintNs",
        "scrollPosition",
        "counters",
        "statusHex",
        "classification",
        "statusFlags",
        "paintTreeNs"
      ],
      "properties": {
        "rawStatus": {
          "type": "integer",
          "minimum": 0
        },
        "rowPaintCount": {
          "type": "integer",
          "minimum": 0
        },
        "rowPaintNs": {
          "type": "integer",
          "minimum": 0
        },
        "imagePaintCount": {
          "type": "integer",
          "minimum": 0
        },
        "imagePaintNs": {
          "type": "integer",
          "minimum": 0
        },
        "scrollPosition": {
          "type": "integer",
          "minimum": 0
        },
        "counters": {
          "$ref": "#/$defs/counters"
        },
        "statusHex": {
          "type": "string",
          "pattern": "0x[0-9a-f]+"
        },
        "classification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "statusFlags": {
          "type": "object",
          "required": [
            "handled",
            "identityAttempted",
            "identityHit",
            "identityFallback",
            "physicalCopyHit",
            "targetColorAttempted",
            "targetColorHit",
            "targetColorMaterialized",
            "targetColorFallback",
            "physicalVariantAttempted",
            "physicalVariantHit",
            "physicalVariantMaterialized",
            "physicalVariantFallback",
            "genericGeometry",
            "smoothResample"
          ],
          "additionalProperties": false,
          "properties": {
            "handled": {
              "type": "boolean"
            },
            "identityAttempted": {
              "type": "boolean"
            },
            "identityHit": {
              "type": "boolean"
            },
            "identityFallback": {
              "type": "boolean"
            },
            "physicalCopyHit": {
              "type": "boolean"
            },
            "targetColorAttempted": {
              "type": "boolean"
            },
            "targetColorHit": {
              "type": "boolean"
            },
            "targetColorMaterialized": {
              "type": "boolean"
            },
            "targetColorFallback": {
              "type": "boolean"
            },
            "physicalVariantAttempted": {
              "type": "boolean"
            },
            "physicalVariantHit": {
              "type": "boolean"
            },
            "physicalVariantMaterialized": {
              "type": "boolean"
            },
            "physicalVariantFallback": {
              "type": "boolean"
            },
            "genericGeometry": {
              "type": "boolean"
            },
            "smoothResample": {
              "type": "boolean"
            }
          }
        },
        "paintTreeNs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "rawStatus",
        "rowPaintCount",
        "rowPaintNs",
        "imagePaintCount",
        "imagePaintNs",
        "scrollPosition",
        "counters",
        "statusHex",
        "classification",
        "statusFlags",
        "datasetIndex",
        "rowIndex",
        "imageControlPaintNs",
        "path",
        "format",
        "copyRectAttemptsExceedOne"
      ],
      "properties": {
        "rawStatus": {
          "type": "integer",
          "minimum": 0
        },
        "rowPaintCount": {
          "type": "integer",
          "minimum": 0
        },
        "rowPaintNs": {
          "type": "integer",
          "minimum": 0
        },
        "imagePaintCount": {
          "type": "integer",
          "minimum": 0
        },
        "imagePaintNs": {
          "type": "integer",
          "minimum": 0
        },
        "scrollPosition": {
          "type": "integer",
          "minimum": 0
        },
        "counters": {
          "$ref": "#/$defs/counters"
        },
        "statusHex": {
          "type": "string",
          "pattern": "0x[0-9a-f]+"
        },
        "classification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "statusFlags": {
          "type": "object",
          "required": [
            "handled",
            "identityAttempted",
            "identityHit",
            "identityFallback",
            "physicalCopyHit",
            "targetColorAttempted",
            "targetColorHit",
            "targetColorMaterialized",
            "targetColorFallback",
            "physicalVariantAttempted",
            "physicalVariantHit",
            "physicalVariantMaterialized",
            "physicalVariantFallback",
            "genericGeometry",
            "smoothResample"
          ],
          "additionalProperties": false,
          "properties": {
            "handled": {
              "type": "boolean"
            },
            "identityAttempted": {
              "type": "boolean"
            },
            "identityHit": {
              "type": "boolean"
            },
            "identityFallback": {
              "type": "boolean"
            },
            "physicalCopyHit": {
              "type": "boolean"
            },
            "targetColorAttempted": {
              "type": "boolean"
            },
            "targetColorHit": {
              "type": "boolean"
            },
            "targetColorMaterialized": {
              "type": "boolean"
            },
            "targetColorFallback": {
              "type": "boolean"
            },
            "physicalVariantAttempted": {
              "type": "boolean"
            },
            "physicalVariantHit": {
              "type": "boolean"
            },
            "physicalVariantMaterialized": {
              "type": "boolean"
            },
            "physicalVariantFallback": {
              "type": "boolean"
            },
            "genericGeometry": {
              "type": "boolean"
            },
            "smoothResample": {
              "type": "boolean"
            }
          }
        },
        "datasetIndex": {
          "type": "integer",
          "minimum": 0
        },
        "rowIndex": {
          "type": "integer",
          "minimum": 0
        },
        "imageControlPaintNs": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "jpeg",
            "png"
          ]
        },
        "copyRectAttemptsExceedOne": {
          "type": "boolean"
        }
      }
    }
  }
}
