{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectOperations",
      "Effect": "Allow",
      "Action": [
        "devicefarm:GetProject",
        "devicefarm:ListDevicePools",
        "devicefarm:ListRuns",
        "devicefarm:CreateUpload",
        "devicefarm:GetUpload"
      ],
      "Resource": "arn:aws:devicefarm:us-west-2:801206326054:project:99ef1498-dd84-4764-b596-7f7d3d63b3cb"
    },
    {
      "Sid": "ReadUploadedTestPackages",
      "Effect": "Allow",
      "Action": [
        "devicefarm:GetUpload"
      ],
      "Resource": "arn:aws:devicefarm:us-west-2:801206326054:upload:*"
    },
    {
      "Sid": "ScheduleOnlySelectedIphonePool",
      "Effect": "Allow",
      "Action": [
        "devicefarm:ScheduleRun"
      ],
      "Resource": [
        "arn:aws:devicefarm:us-west-2:801206326054:project:99ef1498-dd84-4764-b596-7f7d3d63b3cb",
        "arn:aws:devicefarm:us-west-2:801206326054:devicepool:99ef1498-dd84-4764-b596-7f7d3d63b3cb/0187f160-c74b-4615-ab08-dbf7b39a5628",
        "arn:aws:devicefarm:us-west-2:801206326054:upload:*"
      ]
    },
    {
      "Sid": "ReadTestRuns",
      "Effect": "Allow",
      "Action": [
        "devicefarm:GetRun",
        "devicefarm:ListJobs",
        "devicefarm:ListArtifacts"
      ],
      "Resource": "arn:aws:devicefarm:us-west-2:801206326054:run:*"
    },
    {
      "Sid": "ReadTestJobs",
      "Effect": "Allow",
      "Action": [
        "devicefarm:GetJob",
        "devicefarm:ListSuites",
        "devicefarm:ListArtifacts"
      ],
      "Resource": "arn:aws:devicefarm:us-west-2:801206326054:job:*"
    },
    {
      "Sid": "ReadTestSuites",
      "Effect": "Allow",
      "Action": [
        "devicefarm:ListTests",
        "devicefarm:ListArtifacts"
      ],
      "Resource": "arn:aws:devicefarm:us-west-2:801206326054:suite:*"
    },
    {
      "Sid": "ReadTestCases",
      "Effect": "Allow",
      "Action": [
        "devicefarm:ListArtifacts"
      ],
      "Resource": "arn:aws:devicefarm:us-west-2:801206326054:test:*"
    }
  ]
}
